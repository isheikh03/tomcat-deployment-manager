# Copy to .env (gitignored) for local development. Placeholders only - never commit real values.
DB_URL=jdbc:postgresql://localhost:5432/tomcat_manager
DB_USERNAME=tomcat_manager
DB_PASSWORD=change-me
# Generate with: openssl rand -base64 32   (losing this key makes stored credentials unrecoverable)
APP_ENCRYPTION_KEY=
# Development only: allow connection tests to 127.0.0.1 / localhost targets.
CONNECTION_ALLOW_LOOPBACK=false
# Previous key while rotating APP_ENCRYPTION_KEY (decrypt only); remove after "Re-encrypt" under Settings.
APP_ENCRYPTION_KEY_PREVIOUS=

# First administrator (only used when no account exists; the password must be changed at first sign-in).
# Leave empty to get a one-time setup token in the log and create the administrator at /setup instead.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
# DEVELOPMENT ONLY: creates admin/admin, operator/operator, viewer/viewer when no account exists. Never on shared servers.
APP_DEV_USERS=false

# HTTPS deployments: true
SESSION_COOKIE_SECURE=false

# Optional notification email (in-application notifications always work)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
NOTIFICATION_EMAIL_FROM=tomcat-deployment-manager@example.com
APP_BASE_URL=
