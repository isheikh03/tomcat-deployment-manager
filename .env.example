# Copy to .env (gitignored) for local development. Placeholders only - never commit real values.
# Every variable the application reads is listed here with its built-in default. A line that is
# present overrides the default, even when empty, so keep the default unless you need to change it.
# On a server (e.g. Tomcat's bin/setenv.sh) set the same names as environment variables instead.

# ---- Server ----------------------------------------------------------------------------------
# Port when run on its own (java -jar / mvn spring-boot:run); an external Tomcat uses its own port.
SERVER_PORT=8080

# ---- Database (PostgreSQL) -------------------------------------------------------------------
TDL_DB_URL=jdbc:postgresql://localhost:5432/tomcat_manager
TDL_DB_USERNAME=tomcat_manager
TDL_DB_PASSWORD=change-me

# ---- Credential encryption -------------------------------------------------------------------
# Generate with: openssl rand -base64 32   (losing this key makes stored credentials unrecoverable)
TDL_APP_ENCRYPTION_KEY=
# Previous key while rotating TDL_APP_ENCRYPTION_KEY (decrypt only); remove after "Re-encrypt" under Settings.
APP_ENCRYPTION_KEY_PREVIOUS=

# ---- Sessions --------------------------------------------------------------------------------
# Idle timeout before signing out (e.g. 30m, 1h).
SESSION_TIMEOUT=30m
# true only when browsers use HTTPS; on plain HTTP sign-in cannot work with true.
TDL_SESSION_COOKIE_SECURE=false

# ---- Accounts --------------------------------------------------------------------------------
# First administrator (only used when no account exists; the password must be changed at first sign-in).
# Leave empty to get a one-time setup token in the log and create the administrator at /setup instead.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
# DEVELOPMENT ONLY: creates admin/admin, operator/operator, viewer/viewer when no account exists. Never on shared servers.
APP_DEV_USERS=false
# Failed sign-ins before an account is locked, and for how long (ISO-8601 duration).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=PT15M
# Minimum password length (values below 8 are raised to 8).
PASSWORD_MIN_LENGTH=8
# "Remember me" on the sign-in page keeps a browser signed in until the user signs out. Technical upper limit
# (ISO-8601 duration, default 10 years); PT0S hides the option.
LOGIN_REMEMBER_ME_VALIDITY=P3650D

# ---- Notification email (optional; in-application notifications always work) -----------------
# Leave SPRING_MAIL_HOST empty to send no email.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
NOTIFICATION_EMAIL_FROM=tomcat-deployment-manager@example.com
# Public URL for links in emails, including any context path, e.g. https://deploy.example.com/tdm
APP_BASE_URL=

# ---- Release library -------------------------------------------------------------------------
# Private directory for uploaded WARs (never web-served). Use an absolute path on servers.
TDL_ARTIFACT_STORAGE=./var/artifacts
# Largest WAR that can be uploaded, and the largest upload request (file plus form fields).
RELEASE_MAX_UPLOAD_SIZE=1GB
RELEASE_MAX_REQUEST_SIZE=1100MB
# Whether deployment operators may upload releases (administrators always can).
RELEASE_OPERATOR_UPLOAD=true

# ---- Connection tests and targets ------------------------------------------------------------
CONNECTION_MAX_CONCURRENT_TESTS=4
# Development only: allow connection tests to 127.0.0.1 / localhost targets.
CONNECTION_ALLOW_LOOPBACK=false
# Optional comma-separated allow/deny lists of target networks, e.g. 10.20.0.0/16,192.168.50.0/24
CONNECTION_ALLOWED_CIDRS=
CONNECTION_DENIED_CIDRS=
# Optional trust store for Tomcat Manager over HTTPS; the JVM's default trust store otherwise.
TLS_TRUST_STORE=
TLS_TRUST_STORE_PASSWORD=
TLS_TRUST_STORE_TYPE=PKCS12

# ---- Deployments -----------------------------------------------------------------------------
# Seconds to wait for an application to start, and healthy checks in a row before it counts as up.
DEPLOYMENT_STARTUP_TIMEOUT=300
DEPLOYMENT_CONSECUTIVE_SUCCESSES=2
# Deployments running at the same time, and instances updated in parallel within one deployment.
DEPLOYMENT_MAX_CONCURRENT=2
DEPLOYMENT_MAX_PARALLEL_TARGETS=4
# Private directory for backups of replaced WARs. Use an absolute path on servers.
TDL_DEPLOYMENT_BACKUP_DIR=./var/backups
# Backups kept per instance and context path (0 = keep all).
DEPLOYMENT_BACKUP_RETENTION=10

# ---- Health monitoring -----------------------------------------------------------------------
HEALTH_MONITORING_ENABLED=true
HEALTH_MONITOR_INTERVAL=PT5M
HEALTH_MAX_CONCURRENT_CHECKS=4
# How long health check results are kept.
HEALTH_RETENTION=P30D

# ---- Display ---------------------------------------------------------------------------------
# Time zone for displayed timestamps, e.g. Asia/Dhaka. Empty means the server's time zone.
APP_TIME_ZONE=
